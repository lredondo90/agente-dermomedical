# Copia este fichero a .env.local y rellénalo.

# Base de datos. Vacío = base local en .data/ (solo desarrollo). En producción, la cadena de conexión de Supabase.
DATABASE_URL=

# Cadena larga y aleatoria para firmar las sesiones (obligatoria en producción).
SESSION_SECRET=
# Contraseña del panel del distribuidor (/panel).
ADMIN_PASSWORD=

# Correo transaccional (Resend). Vacío = los correos se escriben en la consola.
RESEND_API_KEY=
MAIL_FROM="Larimedical Profesional <pedidos@tudominio.es>"

# Datos del distribuidor que aparecen en la web, facturas y textos legales.
COMPANY_NAME=
COMPANY_TAX_ID=
COMPANY_ADDRESS=
COMPANY_EMAIL=
SITE_URL=http://localhost:3000
COMPANY_IBAN=

# Solo para la demo online: 1 = precios de ejemplo en los productos sin precio.
DEMO_PRICES=
