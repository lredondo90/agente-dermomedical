# Copia este fichero a .env.local y rellénalo.

# Base de datos. Vacío = base local en .data/ (solo desarrollo). En producción, la cadena de conexión de Supabase.
DATABASE_URL=

# Cadena larga y aleatoria para firmar las sesiones (obligatoria en producción).
SESSION_SECRET=
# Contraseña del panel del distribuidor (/panel).
ADMIN_PASSWORD=

# Correo transaccional (Resend). Vacío = los correos se escriben en la consola.
RESEND_API_KEY=
MAIL_FROM="Pedidos profesionales <pedidos@tudominio.es>"

# Datos del distribuidor que aparecen en la web, facturas y textos legales.
COMPANY_NAME=
COMPANY_TAX_ID=
COMPANY_ADDRESS=
COMPANY_EMAIL=
SITE_URL=http://localhost:3000
COMPANY_IBAN=

# Marca y catálogo de esta instalación (data/catalogos/<CATALOG>.json). Vacío = Larimedical.
BRAND_NAME=
BRAND_OWNER=
BRAND_HEADLINE=
CATALOG=

# Solo para la demo online: 1 = precios de ejemplo en los productos sin precio.
DEMO_PRICES=

# --- Agente (paso 3). Cada conexión es opcional: sin ella, el agente guarda los mensajes como «sin enviar». ---
# IA (Claude). Sin clave, los mensajes de los clientes pasan a una persona.
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5

# WhatsApp Cloud API (Meta Business). Plantilla aprobada con un parámetro {{1}} para los seguimientos.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=es

# Correos entrantes reenviados a /api/webhooks/email con "Authorization: Bearer <este secreto>".
EMAIL_WEBHOOK_SECRET=

# Búsqueda de clínicas en Google Maps (Places API "New").
GOOGLE_MAPS_API_KEY=

# Secreto para que el programador de tareas llame a /api/agente/tick (seguimientos).
AGENT_CRON_SECRET=
